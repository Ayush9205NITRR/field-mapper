# Optional server-side defaults. Anything set here pre-fills the UI so
# credentials never have to be typed into the browser.
# Copy to .env and fill in. Never commit .env.

PORT=3000

# Airtable personal access token (needs data.records:read + data.records:write)
AIRTABLE_TOKEN=

# Kylas API key (Settings -> API Keys in Kylas)
KYLAS_API_KEY=
KYLAS_BASE_URL=https://api.kylas.io/v1
